# Copy to .env.prod on the server. Never commit the real file.
POSTGRES_USER=miyao
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=miyao_world

# Leave DATABASE_URL unset to use the bundled db service, or point it at a
# managed Postgres (set DB_NULL_POOL=true for Neon).
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DB_NULL_POOL=true

# The site's public origin (no trailing slash). OAuth redirect URIs are built from it.
PUBLIC_URL=https://example.com
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# First admin, created on first start. Use a strong password; change it in /admin/admins.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outgoing mail for 아이디/비밀번호 찾기 (SMTP, port 587 + STARTTLS).
# Leave SMTP_HOST empty to print mails to the backend log instead (local dev).
# Gmail: smtp.gmail.com + an app password · Naver: smtp.naver.com · AWS SES: email-smtp.<region>.amazonaws.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
