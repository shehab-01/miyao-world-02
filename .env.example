# Copy to .env (local) — docker compose reads it automatically.
# Every value has a default, so .env is optional for local dev.
POSTGRES_USER=miyao
POSTGRES_PASSWORD=miyao
POSTGRES_DB=miyao_world

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432

# Social login — see README "Social login setup". Leave blank to disable a provider.
KAKAO_CLIENT_ID=c11bfe36c01630f35f8f74003f829b63
KAKAO_CLIENT_SECRET=CUSX5njEaGEZP4tjp9GDAWjELMgLmCa3
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# First admin account, created (hashed) on backend startup if it doesn't exist yet.
# Changing these later does NOT change an existing admin's password — use /admin/admins.
ADMIN_EMAIL=
ADMIN_PASSWORD=
